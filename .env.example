# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/solitaire_finz_mart
# Hosted examples: Neon, Supabase, Railway, Render all give you this string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solitaire_finz_mart"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
